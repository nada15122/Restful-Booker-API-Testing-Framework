      "item": [
        {
          "name": "CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. AUTH – Create Token\r",
                  "if (pm.response.code === 200 && pm.response.text().includes(\"token\")) {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    \r",
                  "    // Summary #1: Validate token response structure and performance\r",
                  "    pm.test(\"Validate that status code is 200\", function () {\r",
                  "        pm.response.to.have.status(200);\r",
                  "    });\r",
                  "    \r",
                  "    pm.test(\"Validate that response contains token property\", function () {\r",
                  "        pm.expect(jsonData).to.have.property(\"token\");\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that token is not empty\", function () {\r",
                  "        pm.expect(jsonData.token).to.not.eql(\"\");\r",
                  "    });\r",
                  "    \r",
                  "    pm.test(\"Validate that token is not null\", function () {\r",
                  "        pm.expect(jsonData.token).to.not.eql(null);\r",
                  "    });\r",
                  "    \r",
                  "    pm.test(\"Validate that token is a string\", function () {\r",
                  "        pm.expect(jsonData.token).to.be.a(\"string\");\r",
                  "    });\r",
                  "    \r",
                  "    pm.test(\"Validate that token length is reasonable (>10 chars)\", function () {\r",
                  "        pm.expect(jsonData.token.length).to.be.above(10);\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that response time < 500 ms\", function () {\r",
                  "        pm.expect(pm.response.responseTime).to.be.below(700);\r",
                  "    });\r",
                  "    \r",
                  "    pm.environment.set(\"token\", jsonData.token);\r",
                  "    \r",
                  "} else {\r",
                  "    // Summary #2 and TC-05: Handle invalid credentials or empty body (when the token is not generated)\r",
                  "    pm.test(\"Validate that status code is acceptable (200, 400, or 500)\", function () {\r",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 400, 500]);\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that token should NOT be returned\", function () {\r",
                  "        pm.expect(pm.response.text()).to.not.include(\"token\");\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
