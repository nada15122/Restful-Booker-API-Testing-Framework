          "name": "CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 2. BOOKING – Create Booking\r",
                  "var jsonData;\r",
                  "try {\r",
                  "    jsonData = pm.response.json();\r",
                  "} catch (e) {\r",
                  "    jsonData = null;\r",
                  "}\r",
                  "\r",
                  "if (pm.response.code === 200 && jsonData && jsonData.bookingid) {\r",
                  "    \r",
                  "    // Summary #1: Validate booking data correctness\r",
                  "    pm.environment.set(\"id\", jsonData.bookingid);\r",
                  "    if (jsonData.booking) {\r",
                  "        pm.environment.set(\"firstname\", jsonData.booking.firstname);\r",
                  "        pm.environment.set(\"lastname\", jsonData.booking.lastname);\r",
                  "    }\r",
                  "\r",
                  "    pm.test(\"Validate that status code is 200\", function () {\r",
                  "        pm.response.to.have.status(200);\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that booking id is returned and not null\", function () {\r",
                  "        pm.expect(jsonData).to.have.property('bookingid');\r",
                  "        pm.expect(jsonData.bookingid).to.not.be.null;\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that the response contains the booking object\", function () {\r",
                  "        pm.expect(jsonData).to.have.property('booking');\r",
                  "        pm.expect(jsonData.booking).to.not.be.null;\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that totalprice is a number\", function () {\r",
                  "        pm.expect(jsonData.booking.totalprice).to.be.a('number');\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that response time is less than 700 ms\", function () {\r",
                  "        pm.expect(pm.response.responseTime).to.be.below(700);\r",
                  "    });\r",
                  "\r",
                  "} else {\r",
                  "    \r",
                  "    // Summary #2 & Summary #3: Missing required fields / Invalid date range handling\r",
                  "    pm.test(\"Validate that the request failed and status code is an error code (400, 422, or 500)\", function () {\r",
                  "        pm.expect(pm.response.code).to.be.oneOf([400, 422, 500]);\r",
                  "    });\r",
                  "    \r",
                  "    pm.test(\"Validate that no booking ID was returned\", function () {\r",
                  "        if (jsonData) {\r",
                  "            pm.expect(jsonData).to.not.have.property('bookingid');\r",
                  "        } else {\r",
                  "            // التحقق من النص العام للتأكد من عدم توليد الـ bookingid\r",
                  "            pm.expect(pm.response.text()).to.not.include(\"bookingid\");\r",
                  "        }\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
