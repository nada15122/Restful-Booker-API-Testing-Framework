          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 3. BOOKING – Get Booking\r",
                  "\r",
                  "var statusCode = pm.response.code;\r",
                  "var jsonData = null;\r",
                  "\r",
                  "try {\r",
                  "    jsonData = pm.response.json();\r",
                  "} catch (e) {\r",
                  "    jsonData = null;\r",
                  "}\r",
                  "\r",
                  "if (statusCode === 200 && jsonData) {\r",
                  "    \r",
                  "    // Summary #1: Validate booking structure\r",
                  "    \r",
                  "    pm.test(\"Validate that status code is 200\", function () {\r",
                  "        pm.response.to.have.status(200);\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that response time is less than 900ms\", function () {\r",
                  "        pm.expect(pm.response.responseTime).to.be.below(900);\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that response has correct structure and data types\", function () {\r",
                  "        pm.expect(jsonData).to.have.property('firstname');\r",
                  "        pm.expect(jsonData).to.have.property('lastname');\r",
                  "        pm.expect(jsonData).to.have.property('bookingdates');\r",
                  "        \r",
                  "        pm.expect(jsonData.firstname).to.be.a('string');\r",
                  "        pm.expect(jsonData.lastname).to.be.a('string');\r",
                  "        pm.expect(jsonData.bookingdates).to.be.an('object');\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that bookingdates object contains checkin and checkout\", function () {\r",
                  "        pm.expect(jsonData.bookingdates).to.have.property('checkin');\r",
                  "        pm.expect(jsonData.bookingdates).to.have.property('checkout');\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Validate that data matches created booking (Environment data)\", function () {\r",
                  "        var expectedFirstname = pm.environment.get(\"firstname\") || \"Ahmed\";\r",
                  "        var expectedLastname = pm.environment.get(\"lastname\") || \"Test\";\r",
                  "        \r",
                  "        pm.expect(jsonData.firstname).to.eql(expectedFirstname);\r",
                  "        pm.expect(jsonData.lastname).to.eql(expectedLastname);\r",
                  "    });\r",
                  "    \r",
                  "} else if (statusCode === 404) {\r",
                  "    \r",
                  "    // Summary #2: Retrieve non-existing booking\r",
                  "    pm.test(\"Validate that status code is 404 for non-existing booking\", function () {\r",
                  "        pm.response.to.have.status(404);\r",
                  "    });\r",
                  "    \r",
                  "} else {\r",
                  "    pm.test(\"Validate that request failed with unexpected status code\", function () {\r",
                  "        pm.expect.fail(\"Received unexpected status code: \" + statusCode);\r",
                  "    });\r",
                  "}"
