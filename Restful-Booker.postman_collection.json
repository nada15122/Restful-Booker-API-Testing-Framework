        {
          "name": "DeleteBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 6. BOOKING – Delete Booking\r",
                  "\r",
                  "var statusCode = pm.response.code;\r",
                  "\r",
                  "// Summary #1: Delete booking with valid token\r",
                  "if (statusCode === 201) {\r",
                  "    \r",
                  "    pm.test(\"Validate that status code is 201 on successful deletion\", function () {\r",
                  "        pm.response.to.have.status(201);\r",
                  "    });\r",
                  "    \r",
                  "    // Summary #2: Validate deletion - GET returns 404\r",
                  "    pm.test(\"Validate that GET booking returns 404 after deletion\", function () {\r",
                  "        const bookingId = pm.environment.get(\"id\");\r",
                  "        const baseUrl = pm.environment.get(\"baseURL\");\r",
                  "\r",
                  "        pm.sendRequest({\r",
                  "            url: baseUrl + \"/booking/\" + bookingId,\r",
                  "            method: 'GET',\r",
                  "            header: {\r",
                  "                'Accept': 'application/json'\r",
                  "            }\r",
                  "        }, function (err, res) {\r",
                  "            if (err) {\r",
                  "                console.log(\"Error during GET request:\", err);\r",
                  "            } else {\r",
                  "                pm.expect(res.code).to.equal(404);\r",
                  "            }\r",
                  "        });\r",
                  "    });\r",
                  "    \r",
                  "    // Summary #3: Delete already deleted booking\r",
                  "    pm.test(\"Validate that deleting already deleted booking returns 404 or 405\", function () {\r",
                  "        const bookingId = pm.environment.get(\"id\");\r",
                  "        const baseUrl = pm.environment.get(\"baseURL\");\r",
                  "        const token = pm.environment.get(\"token\");\r",
                  "\r",
                  "        pm.sendRequest({\r",
                  "            url: baseUrl + \"/booking/\" + bookingId,\r",
                  "            method: 'DELETE',\r",
                  "            header: {\r",
                  "                'Content-Type': 'application/json',\r",
                  "                'Cookie': 'token=' + token\r",
                  "            }\r",
                  "        }, function (err, res) {\r",
                  "            if (err) {\r",
                  "                console.log(\"Error during DELETE request:\", err);\r",
                  "            } else {\r",
                  "                pm.expect(res.code).to.be.oneOf([404, 405]);\r",
                  "            }\r",
                  "        });\r",
                  "    });\r",
                  "    \r",
                  "// Summary #4 (TC-31): Delete booking without token / authentication\r",
                  "} else if (statusCode === 403 || statusCode === 405) {\r",
                  "    \r",
                  "    pm.test(\"Validate that status code is 403 or 405 when missing token\", function () {\r",
                  "        pm.expect(statusCode).to.be.oneOf([403, 405]);\r",
                  "    });\r",
